# Copy to .env (local) or enter these in cPanel -> Setup Node.js App -> Environment variables.

# --- MySQL database (cPanel -> MySQL Databases) ---------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_chalao
DB_USER=cpaneluser_chalao
DB_PASSWORD=

# --- Login security --------------------------------------------------------------------
# A long random string (32+ characters). Changing it signs everyone out and makes saved
# courier keys unreadable (unless ENCRYPTION_KEY is set separately).
AUTH_SECRET=
# Optional: a separate key for courier/channel credentials. Defaults to AUTH_SECRET.
ENCRYPTION_KEY=

# --- Site ------------------------------------------------------------------------------
# The public address of the site, no trailing slash. Used for webhook and invite links.
SITE_URL=https://your-domain.com
# Comma-separated emails that become platform admins when they sign in or sign up.
ADMIN_EMAILS=you@example.com

# --- Files -----------------------------------------------------------------------------
# Folder for uploaded logos. Keep it OUTSIDE the app folder so updates never delete it.
UPLOAD_DIR=/home/cpaneluser/chalao-uploads
